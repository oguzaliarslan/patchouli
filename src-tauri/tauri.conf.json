{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchouli",
  "version": "0.1.0",
  "identifier": "app.tracker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Patchouli",
        "visible": false,
        "width": 1200,
        "height": 780,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/*"
    ],
    "license": "../LICENSE",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "compression": "lzma"
      },
      "wix": {
        "bannerPath": "installer/banner.bmp",
        "dialogImagePath": "installer/dialog.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFMDg2NzY3MzcyRUI4RkQKUldUOXVDNDNaMmNJM2tBV2RKanY5L3RINWVEYW5rSStFbjlsZGRnUThyQ3J0NERIN3J1SW8vaVEK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
