{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tracker",
  "version": "0.1.0",
  "identifier": "app.tracker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tracker",
        "visible": false,
        "width": 1200,
        "height": 780,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"]
  }
}
